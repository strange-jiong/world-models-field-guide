        <mxCell id="n1" value="阶段一　预训练&lt;br&gt;Open X-Embodiment（有动作）+ Something-Something v2（无动作）&lt;br&gt;150 万条轨迹混在一起训 next-token prediction" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#aed6b8;strokeWidth=1.2;fontSize=13;fontFamily=Noto Sans CJK SC;fontColor=#1f4a26;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="565" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="阶段二　微调&lt;br&gt;在目标域打开动作分支 + 奖励头，少量数据即可" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdeede;strokeColor=#eec28c;strokeWidth=1.2;fontSize=13;fontFamily=Noto Sans CJK SC;fontColor=#7a4a12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="142" width="565" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="阶段三　当世界模型用&lt;br&gt;包成环境，接 MPC 或想象内 actor-critic" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2ecfa;strokeColor=#c6b3e2;strokeWidth=1.2;fontSize=13;fontFamily=Noto Sans CJK SC;fontColor=#45306b;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="244" width="565" height="62" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="关键实现细节：动作经线性层「加到」第一个视觉 token 的 embedding 上。&lt;br&gt;不改变序列长度 → 无动作时置零即可 → 有/无标注数据可以混训。" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7e0;strokeColor=#e6cf8c;strokeWidth=1;fontSize=12;fontFamily=Noto Sans CJK SC;fontColor=#6b5618;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
